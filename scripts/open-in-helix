#!/bin/bash

# Open selected file in Yazi into the active Helix session
# This script is called by Yazi when a file is selected

set -euo pipefail

SELECTED_FILE="$1"

if [ -z "$SELECTED_FILE" ]; then
    echo "No file selected"
    exit 1
fi

if [ ! -e "$SELECTED_FILE" ]; then
    echo "File does not exist: $SELECTED_FILE"
    exit 1
fi

# Check if we're in a Zellij session
if [ -n "$ZELLIJ" ]; then
    # Find the Helix pane
    PANE_ID=$(zellij query --panes | jq -r '.[] | select(.command | contains("hx")) | .id' | head -n 1)

    if [ -n "$PANE_ID" ]; then
        # Send the open command to Helix
        zellij action --pane-id "$PANE_ID" run -c "hx --path $SELECTED_FILE"
    else
        # Fallback: open in new Helix instance
        hx "$SELECTED_FILE"
    fi
else
    # Not in Zellij, just open with Helix
    hx "$SELECTED_FILE"
fi
